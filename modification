ALTER PROCEDURE [dbo].[batch_safe_insert_with_type_conversion]
    @TableName      NVARCHAR(128),
    @Columns        NVARCHAR(MAX),
    @ValuesBatch    NVARCHAR(MAX),
    @HasIdentity    BIT = 0,
    @IdentityCol    NVARCHAR(128) = NULL
AS
BEGIN
    SET NOCOUNT ON;
    SET LOCK_TIMEOUT 5000;
    SET DEADLOCK_PRIORITY LOW;
    SET XACT_ABORT OFF;

    DECLARE @RS NCHAR(1) = NCHAR(30);
    DECLARE @CS NCHAR(1) = NCHAR(29);

    -------------------------------------------------------------------------
    -- 1. Validation table
    -------------------------------------------------------------------------
    DECLARE @objectId INT;

    SELECT @objectId = t.object_id
    FROM sys.tables t
    INNER JOIN sys.schemas s
        ON s.schema_id = t.schema_id
    WHERE s.name = N'dbo'
      AND t.name = @TableName;

    IF @objectId IS NULL
    BEGIN
        THROW 50100, N'Table invalide.', 1;
    END;

    -------------------------------------------------------------------------
    -- 2. Identity
    -------------------------------------------------------------------------
    IF @HasIdentity = 1
       AND (@IdentityCol IS NULL OR LEN(@IdentityCol) = 0)
    BEGIN
        SELECT TOP (1)
            @IdentityCol = c.name
        FROM sys.columns c
        WHERE c.object_id = @objectId
          AND c.is_identity = 1;
    END;

    IF @HasIdentity = 1
       AND @IdentityCol IS NOT NULL
       AND NOT EXISTS
       (
           SELECT 1
           FROM sys.columns c
           WHERE c.object_id = @objectId
             AND c.name = @IdentityCol
             AND c.is_identity = 1
       )
    BEGIN
        THROW 50101, N'Colonne IDENTITY invalide.', 1;
    END;

    -------------------------------------------------------------------------
    -- 3. Colonnes + métadonnées
    -------------------------------------------------------------------------
    CREATE TABLE #Cols
    (
        Ord          INT NOT NULL PRIMARY KEY,
        ColName      NVARCHAR(128) NOT NULL,
        DataType     NVARCHAR(128) NULL,
        MaxLength    INT NULL,
        [Precision]  INT NULL,
        Scale        INT NULL,
        IsNullable   BIT NULL,
        IsComputed   BIT NULL,
        IsIdentity   BIT NULL
    );

    INSERT INTO #Cols
    (
        Ord,
        ColName
    )
    SELECT
        Ord,
        LTRIM(RTRIM(REPLACE(REPLACE(Item, N'[', N''), N']', N'')))
    FROM dbo.SplitByCommaOrdered(@Columns);

    UPDATE x
    SET
        x.DataType = TYPE_NAME(c.system_type_id),

        x.MaxLength =
            CASE
                WHEN c.max_length = -1 THEN -1
                WHEN TYPE_NAME(c.system_type_id) IN (N'nvarchar', N'nchar')
                    THEN c.max_length / 2
                ELSE c.max_length
            END,

        x.[Precision] = c.precision,
        x.Scale       = c.scale,
        x.IsNullable  = c.is_nullable,
        x.IsComputed  = c.is_computed,
        x.IsIdentity  = c.is_identity

    FROM #Cols x
    INNER JOIN sys.columns c
        ON c.object_id = @objectId
       AND c.name = x.ColName;

    IF EXISTS
    (
        SELECT 1
        FROM #Cols
        WHERE DataType IS NULL
           OR IsComputed = 1
           OR IsIdentity = 1
           OR DataType IN (N'timestamp', N'rowversion')
    )
    BEGIN
        THROW 50102, N'Liste de colonnes invalide.', 1;
    END;

    DECLARE @colCount INT;
    SELECT @colCount = COUNT(*) FROM #Cols;

    -------------------------------------------------------------------------
    -- 4. Contraintes PK / UNIQUE
    -------------------------------------------------------------------------
    CREATE TABLE #Pk
    (
        ConstraintName NVARCHAR(255) NOT NULL,
        ColName        NVARCHAR(128) NOT NULL,
        ConstraintOrd  INT NOT NULL,
        ColOrd         INT NOT NULL
    );

    INSERT INTO #Pk
    (
        ConstraintName,
        ColName,
        ConstraintOrd,
        ColOrd
    )
    SELECT
        tc.CONSTRAINT_NAME,
        kcu.COLUMN_NAME,
        kcu.ORDINAL_POSITION,
        c.Ord
    FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS tc
    INNER JOIN INFORMATION_SCHEMA.KEY_COLUMN_USAGE kcu
        ON kcu.CONSTRAINT_NAME = tc.CONSTRAINT_NAME
       AND kcu.CONSTRAINT_SCHEMA = tc.CONSTRAINT_SCHEMA
       AND kcu.TABLE_NAME = tc.TABLE_NAME
       AND kcu.TABLE_SCHEMA = tc.TABLE_SCHEMA
    INNER JOIN #Cols c
        ON c.ColName = kcu.COLUMN_NAME
    WHERE tc.TABLE_SCHEMA = N'dbo'
      AND tc.TABLE_NAME = @TableName
      AND tc.CONSTRAINT_TYPE IN (N'PRIMARY KEY', N'UNIQUE')
      AND
      (
          @IdentityCol IS NULL
          OR kcu.COLUMN_NAME <> @IdentityCol
      );

    -------------------------------------------------------------------------
    -- Liste distincte des contraintes
    -------------------------------------------------------------------------
    CREATE TABLE #Constraints
    (
        Id INT IDENTITY(1,1) PRIMARY KEY,
        ConstraintName NVARCHAR(255) NOT NULL
    );

    INSERT INTO #Constraints(ConstraintName)
    SELECT DISTINCT ConstraintName
    FROM #Pk;

    -------------------------------------------------------------------------
    -- 5. Découpage sécurisé du batch
    -------------------------------------------------------------------------
    CREATE TABLE #Vals
    (
        RowIndex INT NOT NULL,
        ColOrd   INT NOT NULL,
        RawValue NVARCHAR(MAX) NULL,
        IsNull   BIT NOT NULL,

        PRIMARY KEY(RowIndex, ColOrd)
    );

    DECLARE @batchLen INT;
    SET @batchLen = LEN(ISNULL(@ValuesBatch, N''));

    IF @batchLen = 0
    BEGIN
        SELECT
            0 AS RowIndex,
            CAST(NULL AS NVARCHAR(100)) AS NewID,
            N'Batch vide (aucune donnée)' AS ErrorMessage;

        RETURN;
    END;

    DECLARE @cur INT = 1;
    DECLARE @next INT;
    DECLARE @line NVARCHAR(MAX);
    DECLARE @rowIdx INT = 0;

    WHILE @cur <= @batchLen
    BEGIN
        SET @next = CHARINDEX(@RS, @ValuesBatch, @cur);

        IF @next = 0
        BEGIN
            SET @line =
                SUBSTRING(
                    @ValuesBatch,
                    @cur,
                    @batchLen - @cur + 1
                );

            SET @cur = @batchLen + 1;
        END
        ELSE
        BEGIN
            SET @line =
                SUBSTRING(
                    @ValuesBatch,
                    @cur,
                    @next - @cur
                );

            SET @cur = @next + 1;
        END;

        SET @rowIdx = @rowIdx + 1;

        DECLARE @p INT = 1;
        DECLARE @n INT;
        DECLARE @token NVARCHAR(MAX);
        DECLARE @ord INT = 1;

        WHILE 1 = 1
        BEGIN
            SET @n = CHARINDEX(@CS, @line, @p);

            IF @n = 0
            BEGIN
                SET @token =
                    SUBSTRING(
                        @line,
                        @p,
                        LEN(@line) - @p + 1
                    );
            END
            ELSE
            BEGIN
                SET @token =
                    SUBSTRING(
                        @line,
                        @p,
                        @n - @p
                    );
            END;

            SET @token = LTRIM(RTRIM(@token));

            DECLARE @raw NVARCHAR(MAX);
            DECLARE @isNull BIT;

            SET @raw = NULL;
            SET @isNull = 0;

            -------------------------------------------------------------
            -- NULL
            -------------------------------------------------------------
            IF UPPER(@token) = N'NULL'
            BEGIN
                SET @raw = NULL;
                SET @isNull = 1;
            END

            -------------------------------------------------------------
            -- N'texte'
            -------------------------------------------------------------
            ELSE IF LEN(@token) >= 3
                AND UPPER(LEFT(@token, 2)) = N'N'''
                AND RIGHT(@token, 1) = N''''
            BEGIN
                SET @raw =
                    SUBSTRING(
                        @token,
                        3,
                        LEN(@token) - 3
                    );

                SET @raw =
                    REPLACE(@raw, N'''''', N'''');
            END

            -------------------------------------------------------------
            -- 'texte'
            -------------------------------------------------------------
            ELSE IF LEN(@token) >= 2
                AND LEFT(@token, 1) = N''''
                AND RIGHT(@token, 1) = N''''
            BEGIN
                SET @raw =
                    SUBSTRING(
                        @token,
                        2,
                        LEN(@token) - 2
                    );

                SET @raw =
                    REPLACE(@raw, N'''''', N'''');
            END

            -------------------------------------------------------------
            -- valeur brute
            -------------------------------------------------------------
            ELSE
            BEGIN
                SET @raw = @token;
            END;

            INSERT INTO #Vals
            (
                RowIndex,
                ColOrd,
                RawValue,
                IsNull
            )
            VALUES
            (
                @rowIdx,
                @ord,
                @raw,
                @isNull
            );

            SET @ord = @ord + 1;

            IF @n = 0
                BREAK;

            SET @p = @n + 1;
        END;

        IF (@ord - 1) <> @colCount
        BEGIN
            THROW 50103, N'Nombre de valeurs différent du nombre de colonnes.', 1;
        END;
    END;

    -------------------------------------------------------------------------
    -- 6. Résultat
    -------------------------------------------------------------------------
    DECLARE @out TABLE
    (
        RowIndex     INT,
        NewID        NVARCHAR(100),
        ErrorMessage NVARCHAR(MAX)
    );

    DECLARE @totalRows INT;
    SELECT @totalRows = MAX(RowIndex)
    FROM #Vals;

    SET @rowIdx = 1;

    -------------------------------------------------------------------------
    -- Variables réutilisées
    -------------------------------------------------------------------------
    DECLARE @colOrd INT;
    DECLARE @colName NVARCHAR(128);
    DECLARE @dataType NVARCHAR(128);
    DECLARE @maxLength INT;
    DECLARE @precision INT;
    DECLARE @scale INT;
    DECLARE @nullable BIT;

    DECLARE @rawValue NVARCHAR(MAX);
    DECLARE @nullValue BIT;

    DECLARE @typeDeclaration NVARCHAR(200);
    DECLARE @conversionSql NVARCHAR(MAX);
    DECLARE @conversionOk BIT;
    DECLARE @conversionError NVARCHAR(MAX);

    DECLARE @constraintId INT;
    DECLARE @constraintCount INT;
    DECLARE @constraintName NVARCHAR(255);

    DECLARE @pkPos INT;
    DECLARE @pkCount INT;
    DECLARE @pkCol NVARCHAR(128);
    DECLARE @pkColOrd INT;

    DECLARE @whereClause NVARCHAR(MAX);
    DECLARE @checkSql NVARCHAR(MAX);
    DECLARE @exists BIT;
    DECLARE @dupId NVARCHAR(100);

    DECLARE @safeColumns NVARCHAR(MAX);
    DECLARE @selectValues NVARCHAR(MAX);
    DECLARE @insertExpression NVARCHAR(MAX);
    DECLARE @insertSql NVARCHAR(MAX);
    DECLARE @newId NVARCHAR(100);

    SELECT @constraintCount = COUNT(*)
    FROM #Constraints;

    -------------------------------------------------------------------------
    -- 7. Traitement ligne par ligne
    -------------------------------------------------------------------------
    WHILE @rowIdx <= @totalRows
    BEGIN

        ---------------------------------------------------------------------
        -- 7A. Vérification des conversions
        ---------------------------------------------------------------------
        SET @conversionError = NULL;
        SET @colOrd = 1;

        WHILE @colOrd <= @colCount
        BEGIN
            SELECT
                @colName   = ColName,
                @dataType  = DataType,
                @maxLength = MaxLength,
                @precision = [Precision],
                @scale     = Scale,
                @nullable  = IsNullable
            FROM #Cols
            WHERE Ord = @colOrd;

            SELECT
                @rawValue = RawValue,
                @nullValue = IsNull
            FROM #Vals
            WHERE RowIndex = @rowIdx
              AND ColOrd = @colOrd;

            -------------------------------------------------------------
            -- NULL sur NOT NULL
            -------------------------------------------------------------
            IF @nullValue = 1
               AND @nullable = 0
            BEGIN
                SET @conversionError =
                    N'ERR NULL interdit'
                    + N' | Colonne=' + @colName
                    + N' | Type=' + @dataType;

                BREAK;
            END;

            -------------------------------------------------------------
            -- Valeur non NULL
            -------------------------------------------------------------
            IF @nullValue = 0
            BEGIN

                ---------------------------------------------------------
                -- Type SQL complet
                ---------------------------------------------------------
                SET @typeDeclaration = @dataType;

                IF @dataType IN
                (
                    N'varchar',
                    N'char',
                    N'varbinary',
                    N'binary',
                    N'nvarchar',
                    N'nchar'
                )
                BEGIN
                    SET @typeDeclaration =
                        @dataType
                        + N'('
                        + CASE
                            WHEN @maxLength = -1 THEN N'MAX'
                            ELSE CAST(@maxLength AS NVARCHAR(10))
                          END
                        + N')';
                END;

                IF @dataType IN (N'decimal', N'numeric')
                BEGIN
                    SET @typeDeclaration =
                        @dataType
                        + N'('
                        + CAST(@precision AS NVARCHAR(10))
                        + N','
                        + CAST(@scale AS NVARCHAR(10))
                        + N')';
                END;

                IF @dataType IN
                (
                    N'datetime2',
                    N'time',
                    N'datetimeoffset'
                )
                BEGIN
                    SET @typeDeclaration =
                        @dataType
                        + N'('
                        + CAST(@scale AS NVARCHAR(10))
                        + N')';
                END;

                ---------------------------------------------------------
                -- Texte : contrôle longueur uniquement
                ---------------------------------------------------------
                IF @dataType IN
                (
                    N'varchar',
                    N'nvarchar',
                    N'char',
                    N'nchar'
                )
                BEGIN
                    IF @maxLength <> -1
                       AND LEN(@rawValue) > @maxLength
                    BEGIN
                        SET @conversionError =
                            N'ERR longueur'
                            + N' | Colonne=' + @colName
                            + N' | Type=' + @typeDeclaration;

                        BREAK;
                    END;
                END

                ---------------------------------------------------------
                -- text / ntext
                ---------------------------------------------------------
                ELSE IF @dataType IN (N'text', N'ntext')
                BEGIN
                    -- Rien.
                END

                ---------------------------------------------------------
                -- Tous les types convertibles
                ---------------------------------------------------------
                ELSE
                BEGIN
                    SET @conversionOk = 0;

                    IF @dataType IN
                    (
                        N'date',
                        N'datetime',
                        N'datetime2',
                        N'smalldatetime'
                    )
                    BEGIN
                        SET @conversionSql =
                            N'SELECT @ok =
                                CASE
                                    WHEN COALESCE(
                                        TRY_CONVERT(' + @typeDeclaration + N', @v, 126),
                                        TRY_CONVERT(' + @typeDeclaration + N', @v, 121),
                                        TRY_CONVERT(' + @typeDeclaration + N', @v, 120),
                                        TRY_CONVERT(' + @typeDeclaration + N', @v, 103),
                                        TRY_CONVERT(' + @typeDeclaration + N', @v)
                                    ) IS NULL
                                    THEN 0
                                    ELSE 1
                                END;';
                    END
                    ELSE
                    BEGIN
                        SET @conversionSql =
                            N'SELECT @ok =
                                CASE
                                    WHEN TRY_CONVERT('
                                + @typeDeclaration
                                + N', @v) IS NULL
                                    THEN 0
                                    ELSE 1
                                END;';
                    END;

                    EXEC sp_executesql
                        @conversionSql,
                        N'@v NVARCHAR(MAX), @ok BIT OUTPUT',
                        @v = @rawValue,
                        @ok = @conversionOk OUTPUT;

                    IF @conversionOk = 0
                    BEGIN
                        SET @conversionError =
                            N'ERR CONVERSION'
                            + N' | Colonne=' + @colName
                            + N' | Type=' + @typeDeclaration
                            + N' | Valeur=' + ISNULL(@rawValue, N'NULL');

                        BREAK;
                    END;
                END;
            END;

            SET @colOrd = @colOrd + 1;
        END;

        IF @conversionError IS NOT NULL
        BEGIN
            INSERT INTO @out
            (
                RowIndex,
                NewID,
                ErrorMessage
            )
            VALUES
            (
                @rowIdx,
                NULL,
                @conversionError
            );

            SET @rowIdx = @rowIdx + 1;
            CONTINUE;
        END;

        ---------------------------------------------------------------------
        -- 7B. Doublons
        ---------------------------------------------------------------------
        SET @exists = 0;
        SET @dupId = NULL;
        SET @constraintId = 1;

        WHILE @constraintId <= @constraintCount
        BEGIN
            SELECT @constraintName = ConstraintName
            FROM #Constraints
            WHERE Id = @constraintId;

            SELECT @pkCount = COUNT(*)
            FROM #Pk
            WHERE ConstraintName = @constraintName;

            SET @pkPos = 1;
            SET @whereClause = N'';

            WHILE @pkPos <= @pkCount
            BEGIN
                SELECT
                    @pkCol = p.ColName,
                    @pkColOrd = p.ColOrd
                FROM
                (
                    SELECT
                        ColName,
                        ColOrd,
                        ROW_NUMBER() OVER
                        (
                            ORDER BY ConstraintOrd
                        ) AS RN
                    FROM #Pk
                    WHERE ConstraintName = @constraintName
                ) p
                WHERE p.RN = @pkPos;

                IF LEN(@whereClause) > 0
                    SET @whereClause += N' AND ';

                SET @whereClause +=
                    N'(
                        (
                            (SELECT IsNull
                             FROM #Vals
                             WHERE RowIndex=@ri
                               AND ColOrd='
                    + CAST(@pkColOrd AS NVARCHAR(10))
                    + N') = 1
                            AND '
                    + QUOTENAME(@pkCol)
                    + N' IS NULL
                        )
                        OR
                        (
                            (SELECT IsNull
                             FROM #Vals
                             WHERE RowIndex=@ri
                               AND ColOrd='
                    + CAST(@pkColOrd AS NVARCHAR(10))
                    + N') = 0
                            AND CONVERT(NVARCHAR(MAX), '
                    + QUOTENAME(@pkCol)
                    + N') =
                                (SELECT RawValue
                                 FROM #Vals
                                 WHERE RowIndex=@ri
                                   AND ColOrd='
                    + CAST(@pkColOrd AS NVARCHAR(10))
                    + N')
                        )
                    )';

                SET @pkPos = @pkPos + 1;
            END;

            IF LEN(@whereClause) > 0
            BEGIN
                SET @checkSql =
                    N'SELECT @found =
                        CASE
                            WHEN EXISTS
                            (
                                SELECT 1
                                FROM [dbo].'
                    + QUOTENAME(@TableName)
                    + N' WITH (NOLOCK)
                                WHERE '
                    + @whereClause
                    + N'
                            )
                            THEN 1
                            ELSE 0
                        END;';

                EXEC sp_executesql
                    @checkSql,
                    N'@ri INT, @found BIT OUTPUT',
                    @ri = @rowIdx,
                    @found = @exists OUTPUT;
            END;

            IF @exists = 1
                BREAK;

            SET @constraintId = @constraintId + 1;
        END;

        IF @exists = 1
        BEGIN
            -------------------------------------------------------------
            -- Récupération ID existant
            -------------------------------------------------------------
            IF @HasIdentity = 1
               AND @IdentityCol IS NOT NULL
            BEGIN
                SET @checkSql =
                    N'SELECT TOP (1)
                          @nid =
                          CONVERT(NVARCHAR(100), '
                    + QUOTENAME(@IdentityCol)
                    + N')
                      FROM [dbo].'
                    + QUOTENAME(@TableName)
                    + N'
                      WHERE '
                    + @whereClause
                    + N';';

                EXEC sp_executesql
                    @checkSql,
                    N'@ri INT, @nid NVARCHAR(100) OUTPUT',
                    @ri = @rowIdx,
                    @nid = @dupId OUTPUT;
            END;

            INSERT INTO @out
            (
                RowIndex,
                NewID,
                ErrorMessage
            )
            VALUES
            (
                @rowIdx,
                @dupId,
                N'Doublon'
            );

            SET @rowIdx = @rowIdx + 1;
            CONTINUE;
        END;

        ---------------------------------------------------------------------
        -- 7C. Construction INSERT sécurisé
        ---------------------------------------------------------------------
        SET @safeColumns = N'';
        SET @selectValues = N'';
        SET @colOrd = 1;

        WHILE @colOrd <= @colCount
        BEGIN
            SELECT
                @colName   = ColName,
                @dataType  = DataType,
                @maxLength = MaxLength,
                @precision = [Precision],
                @scale     = Scale
            FROM #Cols
            WHERE Ord = @colOrd;

            SET @typeDeclaration = @dataType;

            IF @dataType IN
            (
                N'varchar',
                N'char',
                N'varbinary',
                N'binary',
                N'nvarchar',
                N'nchar'
            )
            BEGIN
                SET @typeDeclaration =
                    @dataType
                    + N'('
                    + CASE
                        WHEN @maxLength = -1 THEN N'MAX'
                        ELSE CAST(@maxLength AS NVARCHAR(10))
                      END
                    + N')';
            END;

            IF @dataType IN (N'decimal', N'numeric')
            BEGIN
                SET @typeDeclaration =
                    @dataType
                    + N'('
                    + CAST(@precision AS NVARCHAR(10))
                    + N','
                    + CAST(@scale AS NVARCHAR(10))
                    + N')';
            END;

            IF @dataType IN
            (
                N'datetime2',
                N'time',
                N'datetimeoffset'
            )
            BEGIN
                SET @typeDeclaration =
                    @dataType
                    + N'('
                    + CAST(@scale AS NVARCHAR(10))
                    + N')';
            END;

            IF LEN(@safeColumns) > 0
            BEGIN
                SET @safeColumns += N',';
                SET @selectValues += N',';
            END;

            SET @safeColumns += QUOTENAME(@colName);

            -------------------------------------------------------------
            -- Texte
            -------------------------------------------------------------
            IF @dataType IN
            (
                N'varchar',
                N'nvarchar',
                N'char',
                N'nchar',
                N'text',
                N'ntext'
            )
            BEGIN
                SET @insertExpression =
                    N'(SELECT
                          CASE
                              WHEN IsNull=1 THEN NULL
                              ELSE RawValue
                          END
                       FROM #Vals
                       WHERE RowIndex=@ri
                         AND ColOrd='
                    + CAST(@colOrd AS NVARCHAR(10))
                    + N')';
            END

            -------------------------------------------------------------
            -- Dates
            -------------------------------------------------------------
            ELSE IF @dataType IN
            (
                N'date',
                N'datetime',
                N'datetime2',
                N'smalldatetime'
            )
            BEGIN
                SET @insertExpression =
                    N'(SELECT
                        CASE
                            WHEN IsNull=1 THEN NULL
                            ELSE COALESCE(
                                TRY_CONVERT(' + @typeDeclaration + N', RawValue,126),
                                TRY_CONVERT(' + @typeDeclaration + N', RawValue,121),
                                TRY_CONVERT(' + @typeDeclaration + N', RawValue,120),
                                TRY_CONVERT(' + @typeDeclaration + N', RawValue,103),
                                TRY_CONVERT(' + @typeDeclaration + N', RawValue)
                            )
                        END
                       FROM #Vals
                       WHERE RowIndex=@ri
                         AND ColOrd='
                    + CAST(@colOrd AS NVARCHAR(10))
                    + N')';
            END

            -------------------------------------------------------------
            -- Autres types
            -------------------------------------------------------------
            ELSE
            BEGIN
                SET @insertExpression =
                    N'(SELECT
                        CASE
                            WHEN IsNull=1 THEN NULL
                            ELSE TRY_CONVERT('
                    + @typeDeclaration
                    + N', RawValue)
                        END
                       FROM #Vals
                       WHERE RowIndex=@ri
                         AND ColOrd='
                    + CAST(@colOrd AS NVARCHAR(10))
                    + N')';
            END;

            SET @selectValues += @insertExpression;

            SET @colOrd = @colOrd + 1;
        END;

        ---------------------------------------------------------------------
        -- INSERT
        ---------------------------------------------------------------------
        SET @insertSql =
            N'INSERT INTO [dbo].'
            + QUOTENAME(@TableName)
            + N' ('
            + @safeColumns
            + N') SELECT '
            + @selectValues
            + N';';

        IF @HasIdentity = 1
           AND @IdentityCol IS NOT NULL
        BEGIN
            SET @insertSql +=
                N' SET @nid =
                    CONVERT(
                        NVARCHAR(100),
                        SCOPE_IDENTITY()
                    );';
        END;

        SET @newId = NULL;

        BEGIN TRY
            IF @HasIdentity = 1
               AND @IdentityCol IS NOT NULL
            BEGIN
                EXEC sp_executesql
                    @insertSql,
                    N'@ri INT, @nid NVARCHAR(100) OUTPUT',
                    @ri = @rowIdx,
                    @nid = @newId OUTPUT;
            END
            ELSE
            BEGIN
                EXEC sp_executesql
                    @insertSql,
                    N'@ri INT',
                    @ri = @rowIdx;
            END;

            INSERT INTO @out
            (
                RowIndex,
                NewID,
                ErrorMessage
            )
            VALUES
            (
                @rowIdx,
                @newId,
                NULL
            );
        END TRY
        BEGIN CATCH
            IF XACT_STATE() = -1
            BEGIN
                THROW;
            END;

            INSERT INTO @out
            (
                RowIndex,
                NewID,
                ErrorMessage
            )
            VALUES
            (
                @rowIdx,
                NULL,
                N'ERR: ' + ERROR_MESSAGE()
            );
        END CATCH;

        SET @rowIdx = @rowIdx + 1;
    END;

    -------------------------------------------------------------------------
    -- Résultat
    -------------------------------------------------------------------------
    SELECT
        RowIndex,
        NewID,
        ErrorMessage
    FROM @out
    ORDER BY RowIndex;
END;
GO