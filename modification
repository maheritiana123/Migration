        <e:FunctionBlock>
            <e:FunctionBlock.Title>Liste des équipes gestionnaires</e:FunctionBlock.Title>
		
			<e:StackPanel
			  AlignItems="Stretch"
			  JustifyContent="Justify"
			  Direction="Row"
			  Spacing="Medium"
			  Wrap="Wrap">
			<!-- Equipe gestionnaire en production -->
            <e:Table Width="400px" Type="List" Title="Equipe géstionnaire en production" Summary="Liste des équipes">
                <e:Col Width="45%"/>
                <e:Thead>
					<e:Tr>
						<e:Th Colspan="2" Scope="col" CssStyle="text-align: center; font-weight: bold;" >
							Equipe géstionnaire en production
						</e:Th>
					</e:Tr>
                    <e:Tr>
                        <e:Th Scope="col">Nom</e:Th>
                        <e:Th Scope="col">Actions</e:Th>
                    </e:Tr>
                </e:Thead>
                <e:Tbody>
                    <!--If application config team count is equal to zero the we are displaying this message-->
                    <d:If ConditionExpr="count(Data/AdminTeamList/ApplicationConfigTeam )=0">
                        <d:If.Content>
                            <e:Tr>
                                <e:Td Class="a_vide" Colspan="2">
                                    Aucune équipe gestionnaire définie.
                                </e:Td>
                            </e:Tr>
                        </d:If.Content>
                        <d:If.Else>
                            <d:Foreach Nodeset="Data/AdminTeamList/ApplicationConfigTeam">
                                <e:Tr>
                                    <e:Td Align="center">
                                        <e:Label Visible="{DataBinding IsEdited\=1,ClientSide=True}">
                                            <e:Input Id="IdNewTeamName" Ref="NewTeamName" />
                                        </e:Label>
                                        <e:Label Visible="{DataBinding IsEdited \=0,ClientSide=True}">
                                            <e:Output Id="IdOldTeamName" Ref="TeamName"  />
                                        </e:Label>
                                    </e:Td>
                                    <e:Td>
                                        <e:Link Href="#" Title="Modifier" Id="lnkUpdate" Data.Value1="{DataBinding IsEdited, Mode=TwoWay}" Visible="{DataBinding IsEdited \=0,ClientSide=True}"
																	  Data.Value2="{DataBinding NewTeamName, Mode=TwoWay}"
																	  Data.Value3="{DataBinding TeamName, Mode=TwoWay}">
                                            <e:Img RelPath="std/icoactmod.gif" Alt="Modifier" />
                                            <e:Link.Onclick>
                                                this.DataValue(1,1);
												this.DataValue(2,this.DataValue(3));
												this.FindElement('IdNewTeamName').Focus();
                                            </e:Link.Onclick>
                                        </e:Link>

                                        <e:ImageLink Type="Delete" Alt="Supprimer" Title="Supprimer" Visible="{DataBinding IsEdited \=0,ClientSide=True}"
																		   LightBox.Ref="AdminTeamLightBox" Data.Value1="{DataBinding /Data/CurrentTeam, Mode=TwoWay}"
																  Data.Value2="{DataBinding TeamName,Mode=OneWay}"
																  Onclick="this.DataValue(1, this.DataValue(2)); /* Open the lightbox */ return false;">
                                        </e:ImageLink>

                                        <e:Button Type="Ok" Submission="ConfirmEditTeam"
																		Alt="Ok, confirmer la modification" Title="Ok, confirmer la modification" Visible="{DataBinding IsEdited\=1,ClientSide=True}" />
                                        <e:Link Href="#"  Data.Value1="{DataBinding IsEdited, Mode=TwoWay}" Visible="{DataBinding IsEdited\=1,ClientSide=True}" Title="Abandonner la modification">
                                            <e:Img RelPath="std/bt_cancel.png" Alt="Abandonner la modification" />
                                            <e:Link.Onclick>
                                                this.DataValue(1,0);
                                            </e:Link.Onclick>
                                        </e:Link>
                                    </e:Td>
                                </e:Tr>
                            </d:Foreach>
                        </d:If.Else>
                    </d:If>
                </e:Tbody>
            </e:Table>
			<!--Fin  Equipe gestionnaire en prod -->

			<!-- Equipe gestionnaire en recette -->
