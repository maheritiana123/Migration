ELSE IF UPPER(LEFT(@token, 8)) = N'CONVERT('
BEGIN
    DECLARE @firstQuote INT = CHARINDEX(N'''', @token);
    DECLARE @lastQuote INT =
        LEN(@token) - CHARINDEX(N'''', REVERSE(@token)) + 1;

    IF @firstQuote > 0
       AND @lastQuote > @firstQuote
    BEGIN
        SET @raw =
            SUBSTRING(
                @token,
                @firstQuote + 1,
                @lastQuote - @firstQuote - 1
            );

        SET @raw =
            REPLACE(
                @raw,
                N'''''',
                N''''
            );
    END
    ELSE
    BEGIN
        SET @raw = @token;
    END
END