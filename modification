											<e:Input Id="IdNewTeamNameSit" Ref="NewTeamName" />
										</e:Label>
										<e:Label Visible="{DataBinding IsEdited \=0,ClientSide=True}">
											<e:Output Id="IdOldTeamNameSit" Ref="TeamName"  />
										</e:Label>
									</e:Td>
									<e:Td>
										<e:Link Href="#" Title="Modifier" Id="lnkUpdateSit" Data.Value1="{DataBinding IsEdited, Mode=TwoWay}" Visible="{DataBinding IsEdited \=0,ClientSide=True}"
																	  Data.Value2="{DataBinding NewTeamName, Mode=TwoWay}"
																	  Data.Value3="{DataBinding TeamName, Mode=TwoWay}">
											<e:Img RelPath="std/icoactmod.gif" Alt="Modifier" />
											<e:Link.Onclick>
												this.DataValue(1,1);
												this.DataValue(2,this.DataValue(3));
												this.FindElement('IdNewTeamNameSit').Focus();
											</e:Link.Onclick>
										</e:Link>

										<e:ImageLink Type="Delete" Alt="Supprimer" Title="Supprimer" Visible="{DataBinding IsEdited \=0,ClientSide=True}"
