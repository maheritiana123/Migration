ALTER PROCEDURE [dbo].[batch_get_fk_column_nullable]
    @table NVARCHAR(255),
    @col   NVARCHAR(255)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT is_nullable
    FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_NAME = @table
      AND COLUMN_NAME = @col;
END;


ALTER PROCEDURE [dbo].[batch_get_identity_columns]
    @table NVARCHAR(255)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT COLUMN_NAME
    FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_NAME = @table
      AND COLUMNPROPERTY(
            OBJECT_ID(QUOTENAME(TABLE_SCHEMA) + '.' + QUOTENAME(TABLE_NAME)),
            COLUMN_NAME,
            'IsIdentity'
          ) = 1;
END;


ALTER PROCEDURE [dbo].[batch_pass_through_existingId]
    @idCol     NVARCHAR(255),
    @TableName NVARCHAR(255)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @sql NVARCHAR(MAX);

    -- Protection supplémentaire : vérifier que table + colonne existent.
    IF NOT EXISTS
    (
        SELECT 1
        FROM sys.tables t
        INNER JOIN sys.columns c
            ON c.object_id = t.object_id
        WHERE t.name = @TableName
          AND c.name = @idCol
    )
    BEGIN
        THROW 50001, 'Table ou colonne invalide.', 1;
    END;

    SET @sql =
        N'SELECT CAST(' + QUOTENAME(@idCol) +
        N' AS nvarchar(200)) AS K
          FROM ' + QUOTENAME(@TableName) + N' WITH (NOLOCK);';

    EXEC sp_executesql @sql;
END;