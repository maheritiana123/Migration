IF UPPER(@token) = N'NULL'
BEGIN
    SET @raw = NULL;
    SET @isNull = 1;
END

ELSE IF UPPER(LEFT(@token, 8)) = N'CONVERT('
BEGIN
    ...
END

ELSE IF LEN(@token) >= 3
    AND UPPER(LEFT(@token, 2)) = N'N'''
    AND RIGHT(@token, 1) = N''''
BEGIN
    ...
END

ELSE IF LEN(@token) >= 2
    AND LEFT(@token, 1) = N''''
    AND RIGHT(@token, 1) = N''''
BEGIN
    ...
END

ELSE
BEGIN
    SET @raw = @token;
END;