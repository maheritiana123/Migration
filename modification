ALTER PROCEDURE [dbo].[batch_fixup_deferred_foreignKeys]
    @tableName NVARCHAR(128),
    @setBatch  NVARCHAR(MAX),
    @idCol     NVARCHAR(128),
    @newId     NVARCHAR(255)
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @RS NCHAR(1) = NCHAR(30);
    DECLARE @CS NCHAR(1) = NCHAR(29);

    BEGIN TRY

        ------------------------------------------------------------
        -- 1) Table obligatoirement dans dbo
        ------------------------------------------------------------
        DECLARE @objectId INT =
            OBJECT_ID(N'dbo.' + QUOTENAME(@tableName), N'U');

        IF @objectId IS NULL
            THROW 50001, 'Table invalide.', 1;

        ------------------------------------------------------------
        -- 2) Vérification colonne ID
        ------------------------------------------------------------
        IF NOT EXISTS
        (
            SELECT 1
            FROM sys.columns
            WHERE object_id = @objectId
              AND name = @idCol
        )
            THROW 50002, 'Colonne ID invalide.', 1;

        ------------------------------------------------------------
        -- 3) Parser les affectations
        --
        -- Format :
        --
        -- ColA <CS> valeurA <RS> ColB <CS> valeurB
        ------------------------------------------------------------
        CREATE TABLE #SetValues
        (
            Ord      INT IDENTITY(1,1) PRIMARY KEY,
            ColName  NVARCHAR(128) NOT NULL,
            RawValue NVARCHAR(MAX) NULL,
            IsNull   BIT NOT NULL
        );

        DECLARE @len INT = LEN(ISNULL(@setBatch, N''));
        DECLARE @cur INT = 1;
        DECLARE @next INT;
        DECLARE @item NVARCHAR(MAX);

        WHILE @cur <= @len
        BEGIN
            SET @next = CHARINDEX(@RS, @setBatch, @cur);

            IF @next = 0
                SET @item =
                    SUBSTRING(@setBatch, @cur, @len - @cur + 1);
            ELSE
                SET @item =
                    SUBSTRING(@setBatch, @cur, @next - @cur);

            DECLARE @sep INT = CHARINDEX(@CS, @item);

            IF @sep = 0
                THROW 50003, 'Format setBatch invalide.', 1;

            DECLARE @column NVARCHAR(128) =
                LTRIM(RTRIM(SUBSTRING(@item, 1, @sep - 1)));

            DECLARE @value NVARCHAR(MAX) =
                LTRIM(RTRIM(
                    SUBSTRING(
                        @item,
                        @sep + 1,
                        LEN(@item) - @sep
                    )
                ));

            --------------------------------------------------------
            -- Validation de la colonne
            --------------------------------------------------------
            IF NOT EXISTS
            (
                SELECT 1
                FROM sys.columns
                WHERE object_id = @objectId
                  AND name = @column
                  AND is_identity = 0
                  AND is_computed = 0
            )
                THROW 50004, 'Colonne SET invalide.', 1;

            --------------------------------------------------------
            -- Transformer le token SQL actuel en donnée
            --
            -- NULL       -> NULL
            -- 'bonjour'  -> bonjour
            -- 123        -> 123
            --------------------------------------------------------
            DECLARE @isNull BIT = 0;

            IF UPPER(@value) = N'NULL'
            BEGIN
                SET @isNull = 1;
                SET @value = NULL;
            END
            ELSE IF LEN(@value) >= 2
                 AND LEFT(@value,1) = N''''
                 AND RIGHT(@value,1) = N''''
            BEGIN
                SET @value =
                    SUBSTRING(@value, 2, LEN(@value) - 2);

                SET @value =
                    REPLACE(@value, N'''''', N'''');
            END;

            INSERT INTO #SetValues
            (
                ColName,
                RawValue,
                IsNull
            )
            VALUES
            (
                @column,
                @value,
                @isNull
            );

            IF @next = 0
                BREAK;

            SET @cur = @next + 1;
        END;

        IF NOT EXISTS (SELECT 1 FROM #SetValues)
            THROW 50005, 'Aucune valeur à mettre à jour.', 1;

        ------------------------------------------------------------
        -- 4) Construction du SET
        --
        -- IMPORTANT :
        -- seules les colonnes validées sont concaténées.
        -- Les valeurs restent dans #SetValues.
        ------------------------------------------------------------
        DECLARE @setClause NVARCHAR(MAX) = N'';

        DECLARE
            @ord INT,
            @setCol NVARCHAR(128);

        DECLARE curSet CURSOR LOCAL FAST_FORWARD FOR
        SELECT Ord, ColName
        FROM #SetValues
        ORDER BY Ord;

        OPEN curSet;

        FETCH NEXT FROM curSet
        INTO @ord, @setCol;

        WHILE @@FETCH_STATUS = 0
        BEGIN
            IF LEN(@setClause) > 0
                SET @setClause += N',';

            SET @setClause +=
                QUOTENAME(@setCol)
                + N' = (SELECT CASE WHEN IsNull = 1 '
                + N'THEN NULL ELSE RawValue END '
                + N'FROM #SetValues WHERE Ord = '
                + CAST(@ord AS NVARCHAR(10))
                + N')';

            FETCH NEXT FROM curSet
            INTO @ord, @setCol;
        END;

        CLOSE curSet;
        DEALLOCATE curSet;

        ------------------------------------------------------------
        -- 5) UPDATE
        --
        -- @newId n'est PLUS concaténé.
        ------------------------------------------------------------
        DECLARE @sql NVARCHAR(MAX);

        SET @sql =
            N'UPDATE [dbo].' + QUOTENAME(@tableName)
            + N' SET ' + @setClause
            + N' WHERE ' + QUOTENAME(@idCol)
            + N' = @pNewId;';

        EXEC sp_executesql
            @sql,
            N'@pNewId NVARCHAR(255)',
            @pNewId = @newId;

    END TRY
    BEGIN CATCH
        PRINT ERROR_MESSAGE();
        THROW;
    END CATCH
END;